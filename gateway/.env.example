# AssemblyAI API Key — primary real-time streaming STT (Live Transcript)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Speechmatics API Key — fallback STT used automatically if AssemblyAI fails.
# Optional, but recommended for resilience. At least one of the two STT keys
# above must be set.
SPEECHMATICS_API_KEY=your_speechmatics_api_key_here

OPENAI_API_KEY=your_openai_api_key_here

# Cost anomaly thresholds
ANOMALY_COST_PER_CHUNK_USD=0.05
ANOMALY_COST_PER_MIN_USD=0.10
ANOMALY_SESSION_BUDGET_USD=2.00

# Circuit breaker
LLM_BUDGET_SOFT=60
LLM_BUDGET_HARD=80
