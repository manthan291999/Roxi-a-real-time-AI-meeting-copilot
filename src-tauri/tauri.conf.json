{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roxi",
  "version": "0.1.0",
  "identifier": "com.manth.roxi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Roxi",
        "label": "main",
        "width": 1180,
        "height": 760,
        "minWidth": 480,
        "minHeight": 520,
        "transparent": true,
        "decorations": true,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": true,
        "visible": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
