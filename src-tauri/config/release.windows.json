{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Roxi",
        "label": "main",
        "width": 1180,
        "height": 760,
        "minWidth": 480,
        "minHeight": 520,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
