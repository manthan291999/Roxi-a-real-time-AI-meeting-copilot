{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Roxi",
        "label": "main",
        "width": 1180,
        "height": 760,
        "minWidth": 480,
        "minHeight": 520,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "targets": ["appimage", "deb"],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "pipewire"
        ]
      }
    }
  }
}
