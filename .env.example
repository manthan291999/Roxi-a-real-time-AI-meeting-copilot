# Roxi — environment template. Copy to .env at the REPO ROOT (not gateway/ or
# chatbot/): both Rust and the two Node sidecars read root first, which is what
# makes a packaged .app bundle work — it inherits no shell environment.
#
# Only the three keys at the top are required. Everything below has a working
# default; the values shown are those defaults.

# ---- Required -------------------------------------------------------------
OPENAI_API_KEY=sk-...
# At least one STT provider:
ASSEMBLYAI_API_KEY=
SPEECHMATICS_API_KEY=

# ---- Speech to text -------------------------------------------------------
# STT_PROVIDER=assemblyai
# STT_LANGUAGES=en
# STT_MIN_TURN_SILENCE=400
# STT_MAX_TURN_SILENCE=1500
# STT_MAX_SPEAKERS=10
# STT_MODE=balanced
# STT_VOICE_FOCUS=

# ---- Agent pipeline budgets ----------------------------------------------
# LLM_BUDGET_SOFT=60
# LLM_BUDGET_HARD=80
# ANOMALY_COST_PER_CHUNK_USD=0.05
# ANOMALY_COST_PER_MIN_USD=0.10
# ANOMALY_SESSION_BUDGET_USD=2.00

# ---- Ask Roxi (chatbot sidecar) -------------------------------------------
# CHATBOT_MODEL=gpt-5.6-luna
# CHATBOT_LLM_ADAPTER=openai
# CHATBOT_LLM_BUDGET_SOFT=60
# CHATBOT_LLM_BUDGET_HARD=80
# CHATBOT_EMBED_MODEL=text-embedding-3-small
# CHATBOT_EMBED_BUDGET_HARD=400

# ---- Ask Roxi web search --------------------------------------------------
# THE ONLY web control there is: no UI exposes it. The app never sends a web
# mode, so this value decides for every question. Nothing here needs setting —
# the defaults are the shipped behaviour.
#
#   auto   the model is offered a web-search tool and decides for itself
#          whether the question needs one. A question it can answer directly
#          costs exactly what it cost before this feature existed.
#   always search is forced. Research / fact-check mode. Also reachable per
#          question from the CLI (--web=always) and over the stdio protocol.
#   never  no tool is sent at all, so there is nothing for the model to use.
# CHATBOT_WEB_SEARCH_MODE=auto
#
# Model for the web path only. Empty means "use CHATBOT_MODEL". Set this if
# your chat model does not support the hosted tool — it moves the web path
# without moving any other agent.
# CHATBOT_WEB_SEARCH_MODEL=
#
# Hosted tool id. The adapter falls back once to web_search_preview if the API
# rejects this, which is the name the installed SDK (openai 4.104.0) types.
# CHATBOT_WEB_SEARCH_TOOL_TYPE=web_search
#
# low | medium | high. 'low' is the first latency and cost lever to try.
# CHATBOT_WEB_SEARCH_CONTEXT_SIZE=medium
#
# Searches per turn. 0 means do not send the parameter at all — it is absent
# from this SDK version's types, so opting in is explicit.
# CHATBOT_WEB_MAX_TOOL_CALLS=0
#
# Double the chat gateway's 30s on purpose: a multi-search turn routinely
# exceeds 30s and would otherwise time out mid-answer.
# CHATBOT_WEB_TIMEOUT_MS=60000
#
# Web search gets its own call budget, like embeddings do, so one research
# question cannot starve the conversation it was asked in.
# CHATBOT_WEB_BUDGET_HARD=20
#
# Optional locality for the search tool. Only sent when set.
# CHATBOT_WEB_USER_COUNTRY=
# CHATBOT_WEB_USER_CITY=
# CHATBOT_WEB_USER_REGION=

# ---- Vector memory (local Qdrant) -----------------------------------------
# QDRANT_URL=http://127.0.0.1:6333
# EPISODIC_RETENTION_DAYS=90

# ---- Observability --------------------------------------------------------
# LLM_TRACK_PAYLOADS=1
# LLM_USAGE_TRACKING=1
# CHATBOT_LOG_LEVEL=info
