# Roxi — environment template. Copy to .env at the REPO ROOT (not gateway/ or
# chatbot/): both Rust and the two Node sidecars read root first, which is what
# makes a packaged .app bundle work — it inherits no shell environment.
#
# Only the three keys at the top are required. Everything below has a working
# default; the values shown are those defaults.

# ---- Required -------------------------------------------------------------
OPENAI_API_KEY=sk-...
# At least one STT provider:
ASSEMBLYAI_API_KEY=
SPEECHMATICS_API_KEY=

# ---- Speech to text -------------------------------------------------------
# STT_PROVIDER=assemblyai
# STT_LANGUAGES=en
# STT_MIN_TURN_SILENCE=400
# STT_MAX_TURN_SILENCE=1500
# STT_MAX_SPEAKERS=10
# STT_MODE=balanced
# STT_VOICE_FOCUS=

# ---- Agent pipeline budgets ----------------------------------------------
# LLM_BUDGET_SOFT=60
# LLM_BUDGET_HARD=80
# ANOMALY_COST_PER_CHUNK_USD=0.05
# ANOMALY_COST_PER_MIN_USD=0.10
# ANOMALY_SESSION_BUDGET_USD=2.00

# ---- Ask Roxi (chatbot sidecar) -------------------------------------------
# CHATBOT_MODEL=gpt-5.6-luna
# CHATBOT_LLM_ADAPTER=openai
# CHATBOT_LLM_BUDGET_SOFT=60
# CHATBOT_LLM_BUDGET_HARD=80
# CHATBOT_EMBED_MODEL=text-embedding-3-small
# CHATBOT_EMBED_BUDGET_HARD=400

# ---- Ask Roxi web search --------------------------------------------------
# THE ONLY web control there is: no UI exposes it. The app never sends a web
# mode, so this value decides for every question. Nothing here needs setting —
# the defaults are the shipped behaviour.
#
#   auto   the model is offered a web-search tool and decides for itself
#          whether the question needs one. A question it can answer directly
#          costs exactly what it cost before this feature existed.
#   always search is forced. Research / fact-check mode. Also reachable per
#          question from the CLI (--web=always) and over the stdio protocol.
#   never  no tool is sent at all, so there is nothing for the model to use.
# CHATBOT_WEB_SEARCH_MODE=auto
#
# Model for the web path only. Empty means "use CHATBOT_MODEL". Set this if
# your chat model does not support the hosted tool — it moves the web path
# without moving any other agent.
# CHATBOT_WEB_SEARCH_MODEL=
#
# Hosted tool id. The adapter falls back once to web_search_preview if the API
# rejects this, which is the name the installed SDK (openai 4.104.0) types.
# CHATBOT_WEB_SEARCH_TOOL_TYPE=web_search
#
# low | medium | high. 'low' is the first latency and cost lever to try.
# CHATBOT_WEB_SEARCH_CONTEXT_SIZE=medium
#
# Searches per turn. 0 means do not send the parameter at all — it is absent
# from this SDK version's types, so opting in is explicit.
# CHATBOT_WEB_MAX_TOOL_CALLS=0
#
# Double the chat gateway's 30s on purpose: a multi-search turn routinely
# exceeds 30s and would otherwise time out mid-answer.
# CHATBOT_WEB_TIMEOUT_MS=60000
#
# Web search gets its own call budget, like embeddings do, so one research
# question cannot starve the conversation it was asked in.
# CHATBOT_WEB_BUDGET_HARD=20
#
# Optional locality for the search tool. Only sent when set.
# CHATBOT_WEB_USER_COUNTRY=
# CHATBOT_WEB_USER_CITY=
# CHATBOT_WEB_USER_REGION=

# ---- Vector memory (local Qdrant) -----------------------------------------
# QDRANT_URL=http://127.0.0.1:6333
# EPISODIC_RETENTION_DAYS=90

# ---- Observability --------------------------------------------------------
# LLM_TRACK_PAYLOADS=1
# LLM_USAGE_TRACKING=1
# CHATBOT_LOG_LEVEL=info

# ---- Accounts (desktop app) -----------------------------------------------
# Leave these unset for local-only mode: no login screen, history stays on
# this Mac. With both Supabase values set, the app requires sign-in and can
# import local history into the signed-in workspace.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=           # the project's publishable/anon key (safe to ship)
# ROXI_API_URL=http://localhost:8080
# Release builds require this to be a public HTTPS URL. `npm run stage:release`
# refuses localhost/plain HTTP so an installer sent to another computer cannot
# silently call itself instead of your server.
# ROXI_ENVIRONMENT=production
# ROXI_RELEASE_CHANNEL=stable
# ROXI_NODE_VERSION=             # defaults to the Node version running the build
# ROXI_QDRANT_VERSION=v1.19.1    # pinned; do not use "latest" for a release
# Confirmation emails open the API's "Email confirmed" page
# (ROXI_API_URL + /auth/confirmed). Override with a page of your own if you
# like. Either way, add it to Supabase > Auth > URL Configuration > Redirect
# URLs, or Supabase ignores it and uses the Site URL instead.
# ROXI_EMAIL_REDIRECT_URL=https://roxi.example.com/auth/confirmed
#
# Browser sign-in (optional). Each button appears only when listed here AND
# enabled in the Supabase project. The browser returns to a one-time listener
# on 127.0.0.1, so add this to Auth > URL Configuration > Redirect URLs:
#   http://127.0.0.1:*/auth/callback/**
# SUPABASE_OAUTH_PROVIDERS=azure,google   # azure = "Continue with Microsoft"
# SUPABASE_SSO=true                       # "Company SSO" (SAML; Supabase Pro plan)
#
# Local history is per account: each signed-in account sees only the
# meetings it recorded. Meetings recorded before accounts were turned on have
# no owner and stay hidden from everyone, until the account with this email
# signs in and they are assigned to it. Must be a confirmed Supabase email.
# ROXI_HISTORY_OWNER_EMAIL=admin@yourcompany.com

# ---- Plans & free trial --------------------------------------------------
# Free and local-only users get a 5-minute trial of live capture per Mac;
# pro / team / enterprise workspaces are unlimited. Prices are shown in GBP.
# "Choose plan" opens the website's pricing page; until this is set the
# buttons say "Coming soon".
# VITE_PRICING_URL=https://your-site.vercel.app/pricing
# Admins get full access on any plan, matched on the signed-in email. The app
# owner (ROXI_HISTORY_OWNER_EMAIL above) is always an admin; list any others
# here, comma-separated.
# ROXI_ADMIN_EMAILS=colleague@yourcompany.com
# For developing Roxi itself only: turn the trial meter off.
# ROXI_TRIAL_DISABLED=1

# ---- Cloud API (server/) --------------------------------------------------
# Only needed to run the SaaS backend locally. On Render these are set in the
# service's environment instead. See server/README.md.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# SUPABASE_URL is shared with the desktop settings above.
# SUPABASE_JWT_SECRET=
# STT_TOKEN_TTL_SECS=60
