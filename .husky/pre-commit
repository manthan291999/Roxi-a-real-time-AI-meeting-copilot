#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "Pre-commit checks running..."

# Block .env files
if git diff --cached --name-only | grep -qE '\.env$|\.env\.local$'; then
  echo "BLOCKED: Attempt to commit a .env file."
  echo "Run: git restore --staged <file>"
  exit 1
fi

# Documented placeholders are not secrets. Without this, a .env example in
# the README trips the scan below: SPEECHMATICS_API_KEY=your_speechmatics_key_here
# is 25 non-space characters and so matches the \S{20,} rule. Only values that
# BEGIN with a placeholder marker are excused, so a real key is still caught.
PLACEHOLDER="=[[:space:]]*[\"']?(your[-_]|YOUR[-_]|<|xxx|XXX|changeme|placeholder|example|\.\.\.)"

# Block obvious API key patterns
if git diff --cached | grep -vE "$PLACEHOLDER" | grep -qE '(ASSEMBLYAI_API_KEY\s*=\s*[a-f0-9]{20,}|SPEECHMATICS_API_KEY\s*=\s*\S{20,}|OPENAI_API_KEY\s*=\s*sk-\S+)'; then
  echo "BLOCKED: Potential API key detected in staged changes."
  echo "Review with: git diff --cached"
  exit 1
fi

# TypeScript check
npx tsc --noEmit || { echo "TypeScript errors found."; exit 1; }

echo "Pre-commit checks passed."
